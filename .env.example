# Copy to .env and fill in your Firebase project's values.
# Never commit .env — it holds your API key. See README.md (Setup)
# for the console steps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise (Fraud Defense) site key for App Check (see README.md, Setup step 4).
# v3 Classic is deprecated — Google blocks new v3 onboardings.
VITE_RECAPTCHA_SITE_KEY=

# Set to "true" for local development so App Check uses the debug provider.
# The debug token printed in the browser console must be registered once
# in the Firebase console (App Check > Apps > Manage debug tokens).
VITE_APPCHECK_DEBUG=true
